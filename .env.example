# ---------------------------------------------------------------------------
# Firebase Client SDK (browser / Vite)
# ---------------------------------------------------------------------------
# These values are embedded into the frontend bundle at BUILD TIME by Vite.
# After changing any VITE_* value you MUST run `npm run build` again before
# restarting the production preview (PM2). A PM2 restart alone does not
# re-read these values.
#
# Find them in Firebase Console > Project settings > General > Your apps
# (Web app) > SDK setup and configuration > Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Node / PM2 (not exposed to the browser)
# ---------------------------------------------------------------------------
# Host/port used by `vite preview` when started through ecosystem.config.cjs.
# NODE_ENV is set to "production" by ecosystem.config.cjs, not here (Vite
# warns when NODE_ENV is present in a .env file).
HOST=0.0.0.0
PORT=7000

# ---------------------------------------------------------------------------
# Firebase Admin SDK (trusted Node scripts only)
# ---------------------------------------------------------------------------
# Path to the Firebase service-account JSON used by scripts/ (seed, admin,
# reset). Relative paths are resolved from the repository root. Absolute
# Windows and Linux paths are supported.
#
# NEVER prefix this with VITE_ and NEVER commit the JSON file.
FIREBASE_ADMIN_CREDENTIALS=./ecommerce-firebase-adminsdk.json

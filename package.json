{
  "name": "manual-test-online-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run env:check && vite build",
    "preview": "vite preview",
    "env:check": "node scripts/validateEnv.js",
    "env:check:admin": "node scripts/validateEnv.js --admin",
    "seed": "node scripts/seedFirebase.js",
    "firebase:seed": "node scripts/seedFirebase.js",
    "firebase:admin": "node scripts/setupAdmin.js",
    "firebase:reset-test-data": "node scripts/resetTestData.js --confirm",
    "firebase:deploy": "npx firebase-tools deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase": "^10.12.2",
    "firebase-admin": "^13.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.4"
  }
}
